import StealthKeyExchange.Contract

/-!
# The conformance vectors, replayed through the model

GENERATED by `scripts/gen_vectors.py` from `python/vectors/v0/vectors.json`
(schema `v0`, params `ML-KEM-768+ML-DSA-65`) and `commit_vectors.json`
(schema `v0`, format 0x02) — do not edit; CI regenerates
and diffs. Every `#guard` is checked by the build. Only lengths, version bytes
and addresses appear: that is all the contract reads of an announcement.
-/

namespace StealthKeyExchange.Vectors

/-- A fresh deployment at address `1`: no keys, an empty announcer log. -/
def s0 : State := { self := 1, keys := #[], log := [] }

/-- A ciphertext, view tag or key of the given length (content is irrelevant on-chain). -/
def zeros (n : Nat) : Bytes := List.replicate n 0

/-! ## Declared sizes -/

#guard schemeId = 2
#guard viewTagBytes = 1
#guard Kem.mlkem768.metaAddressBytes .constructionA = 5633
#guard Kem.mlkem768.metaAddressBytes .commit = 1217
#guard Kem.mlkem768.ciphertextBytes = 1088

/-! ## Recipients: meta-addresses type as ML-KEM-768, their keys register -/

-- recipient A: meta-address 5633 B, version 0x01; ek = the last 1184 B
#guard kemOfMetaAddress (0x01 :: zeros 5632) = .ok (.mlkem768, .constructionA)
#guard kemOfEncapsulationKeyLength 1184 = some .mlkem768
#guard (registerViewingKey s0 (zeros 1184)).toBool = true

-- recipient B: meta-address 5633 B, version 0x01; ek = the last 1184 B
#guard kemOfMetaAddress (0x01 :: zeros 5632) = .ok (.mlkem768, .constructionA)
#guard kemOfEncapsulationKeyLength 1184 = some .mlkem768
#guard (registerViewingKey s0 (zeros 1184)).toBool = true

/-- Registering the recipients' keys in order assigns indices 0, 1, … and reads back. -/
def registered : Except Error State := do
  let s := s0
  let (i0, s) ← registerViewingKey s (zeros 1184)
  if i0 ≠ 0 then throw (.noSuchViewingKey i0)
  let (i1, s) ← registerViewingKey s (zeros 1184)
  if i1 ≠ 1 then throw (.noSuchViewingKey i1)
  pure s

#guard registered.toBool = true
#guard (registered >>= fun s => viewingKeyOf s 0) = .ok { kem := .mlkem768, ek := zeros 1184 }
#guard (registered >>= fun s => viewingKeyOf s 1) = .ok { kem := .mlkem768, ek := zeros 1184 }
#guard (registered.map viewingKeyCount) = .ok 2

/-! ## Commitment meta-addresses (format 0x02, D-024): typed by layout and length -/

-- commitment recipient a: meta-address 1217 B, version 0x02; ek = the last 1184 B
#guard kemOfMetaAddress (0x02 :: zeros 1216) = .ok (.mlkem768, .commit)
#guard kemOfEncapsulationKeyLength 1184 = some .mlkem768
-- commitment recipient b: meta-address 1217 B, version 0x02; ek = the last 1184 B
#guard kemOfMetaAddress (0x02 :: zeros 1216) = .ok (.mlkem768, .commit)
#guard kemOfEncapsulationKeyLength 1184 = some .mlkem768
-- commitment recipient c: meta-address 1217 B, version 0x02; ek = the last 1184 B
#guard kemOfMetaAddress (0x02 :: zeros 1216) = .ok (.mlkem768, .commit)
#guard kemOfEncapsulationKeyLength 1184 = some .mlkem768

-- the two layouts never confuse each other: a commitment length under the Construction A byte,
-- or a Construction A length under the commitment byte, is rejected
#guard kemOfMetaAddress (0x01 :: zeros 1216) = .error (.unsupportedMetaAddress 1217 0x01)
#guard kemOfMetaAddress (0x02 :: zeros 5632) = .error (.unsupportedMetaAddress 5633 0x02)

/-! ## Cases: what `announce` does with each announcement -/

