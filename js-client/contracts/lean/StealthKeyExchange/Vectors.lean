#guard (announce s0 0x40bae0a40e9fbbe4d9a530b3c55994603bf5ceb7 (zeros 1088) (zeros 1)).toBool = true
#guard announce s0 0x40bae0a40e9fbbe4d9a530b3c55994603bf5ceb7 (zeros 1088) (zeros 1) = .ok (.mlkem768, { s0 with log := [forwarded s0 0x40bae0a40e9fbbe4d9a530b3c55994603bf5ceb7 (zeros 1088) (zeros 1)] })

