# third-party reference clones (not ours to version here)
pq-sap/
ETHDILITHIUM/

# python venv (durable, do not commit)
python/.venv/

# pnpm store when configured to a workspace-local directory
.pnpm-store/

# editor swap files
*.swp

# compiled presentation (docs/presentation/build.sh regenerates it)
docs/presentation/SUMMARY.html

# envs
.env

# generated theorem/proof browser pages (regenerated by pnpm sync)
lean/docs-proofs/
wiki/src/generated/

# doc-review scratch (ERC-8441 review notes and drafts live outside this repo's
# scope — see D-032). Never commit review scratch here.
docs-review-ws/

# agent-tool local config (LSP server paths, machine-specific)
lean/.omp/

# agent worktrees — each carries a `.git` pointer file, and a tree containing
# `.git` is rejected outright by GitHub's receive-side fsck (hasDotgit), which
# makes any branch that commits one permanently unpushable
.claude/worktrees/

# dependency trees, build output and tool caches. 145k of these files were
# committed once (17M lines); nothing under them belongs in the repo.
node_modules/
dist/
.ruff_cache/
js-client/contracts/cache/
